VITE_API_URL=http://localhost:5001/api

# Firebase — used for Google/GitHub sign-in, App Check (reCAPTCHA), and
# Performance Monitoring. Get these from Firebase Console > Project Settings.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# App Check reCAPTCHA Enterprise site key (Google Cloud Console > Security >
# reCAPTCHA > your key's ID). Leave unset to skip App Check locally.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key

# SEO — both optional, read by src/components/common/Seo.jsx. Leave unset to
# skip GA4 injection / the Search Console verification meta tag locally.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GSC_VERIFICATION=your_google_search_console_verification_token

# Google Maps Embed API (Contact page location map). Optional — restrict this
# key in Google Cloud Console to the Maps Embed API + your site's HTTP
# referrers only. Leave unset to fall back to the keyless maps.google.com
# search embed.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key